NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
TURNSTILE_SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_AUTH_ENABLED=true
TURNSTILE_HOSTNAMES=agendaki.net,www.agendaki.net
SUPER_ADMIN_EMAILS=admin@agendaki.net
ADMIN_BACKUP_ENCRYPTION_KEY=replace-with-64-hex-characters-generated-by-openssl-rand-hex-32
ADMIN_MFA_ENCRYPTION_KEY=replace-with-a-different-64-hex-character-key
ADMIN_MFA_REQUIRED=true
ADMIN_BACKUP_DIR=/var/lib/agendai/backups
RESEND_API_KEY=
# Gemini API key from Google AI Studio; keep private and set only in the API runtime.
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-3.6-flash
EMAIL_FROM="AgendAKI <contas@seudominio.ao>"
CONTACT_EMAIL=equipa@seudominio.ao
REQUIRE_EMAIL_CONFIG=false
TRUST_PROXY=false
DATABASE_URL=postgresql://agendai:agendai@localhost:5432/agendai?schema=public
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-chars
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=agendai-local
S3_REGION=us-east-1
S3_ACCESS_KEY=agendai-local
S3_SECRET_KEY=agendai-local-secret-change-me
