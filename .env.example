# Docker Compose local. In Coolify, configure this as both a build and runtime variable.
NEXT_PUBLIC_SITE_URL=https://agendaki.net
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFQSNsKFVTDHX0z6
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=agendaki.net,www.agendaki.net
SUPER_ADMIN_EMAILS=admin@agendaki.net
# Generate once with: openssl rand -hex 32. Backups cannot be decrypted if this key is lost.
ADMIN_BACKUP_ENCRYPTION_KEY=replace-with-64-hex-characters-generated-by-openssl-rand-hex-32
# Separate encryption key for admin authenticator (TOTP) secrets.
ADMIN_MFA_ENCRYPTION_KEY=replace-with-a-different-64-hex-character-key
ADMIN_MFA_REQUIRED=true
WEB_ORIGIN=https://agendaki.net,https://www.agendaki.net
# Generate your own secret: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-chars
POSTGRES_PASSWORD=replace-with-at-least-32-random-URL-safe-characters
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
API_BIND_ADDRESS=127.0.0.1
API_PORT=3002
WEBSITE_BIND_ADDRESS=127.0.0.1
# Pinned Elestio MinIO compatibility image; the upstream minio/minio image is no longer available.
# This is a frozen legacy release; use a maintained S3 service for long-term production storage.
STORAGE_IMAGE=elestio/minio@sha256:25348a257f1ece1b192f25f6cd9854618fa86422ac87b494b5d4e629c556d4bd
RCLONE_IMAGE=rclone/rclone:1.68.2
POSTGRES_IMAGE=postgres:17.5-alpine
RESEND_API_KEY=
EMAIL_FROM="AgendAKI <contas@seudominio.ao>"
CONTACT_EMAIL=equipa@seudominio.ao
REQUIRE_EMAIL_CONFIG=true
# Set true only when the API is reachable exclusively through one trusted reverse proxy.
TRUST_PROXY=false
# Armazenamento S3 privado. Compose usa MinIO local por omissão.
S3_ENDPOINT=http://storage:9000
S3_PUBLIC_ENDPOINT=https://storage.example.net
S3_BUCKET=agendai-local
S3_REGION=us-east-1
S3_ACCESS_KEY=replace-with-a-unique-key-id
S3_SECRET_KEY=replace-with-at-least-32-random-characters
S3_PORT=9000
S3_CONSOLE_PORT=9001
# Host port for local Docker Compose; the container always listens on 3000.
WEBSITE_PORT=3003
