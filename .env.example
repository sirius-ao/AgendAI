# Docker Compose local. In Coolify, configure this as both a build and runtime variable.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
# Generate your own secret: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-chars
POSTGRES_PASSWORD=agendai-local
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
API_BIND_ADDRESS=127.0.0.1
API_PORT=3002
WEBSITE_BIND_ADDRESS=127.0.0.1
# Pinned Elestio MinIO compatibility image; the upstream minio/minio image is no longer available.
# This is a frozen legacy release; use a maintained S3 service for long-term production storage.
STORAGE_IMAGE=elestio/minio@sha256:25348a257f1ece1b192f25f6cd9854618fa86422ac87b494b5d4e629c556d4bd
RCLONE_IMAGE=rclone/rclone:1.68.2
POSTGRES_IMAGE=postgres:17.5-alpine
RESEND_API_KEY=
EMAIL_FROM="AgendAKI <contas@seudominio.ao>"
CONTACT_EMAIL=equipa@seudominio.ao
REQUIRE_EMAIL_CONFIG=false
TRUST_PROXY=false
# Armazenamento S3 privado. Compose usa MinIO local por omissão.
S3_ENDPOINT=http://storage:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=agendai-local
S3_REGION=us-east-1
S3_ACCESS_KEY=agendai-local
S3_SECRET_KEY=agendai-local-secret-change-me
S3_PORT=9000
S3_CONSOLE_PORT=9001
# Host port for local Docker Compose; the container always listens on 3000.
WEBSITE_PORT=3003
