{
  "name": "agendai",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev": "turbo dev",
    "start": "pnpm --filter @agendai/website start",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:api": "pnpm --filter @agendai/api test",
    "test:a11y": "node scripts/check-accessibility.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.58.2",
    "prettier": "^3.8.3",
    "turbo": "^2.8.20"
  }
}
